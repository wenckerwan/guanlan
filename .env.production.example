# 观澜生产环境变量示例。复制为 .env.production 并在服务器上填写真实值后执行 chmod 600。
# 本文件不包含任何可用密钥；所有密钥项留空，由 compose 的 ${VAR:?message} 语法拒绝空值。

# 应用只绑定回环地址的端口，公网仅通过宝塔 80/443 转发
APP_PORT=

# 应用加密密钥：至少 32 字节随机值，生成方式：openssl rand -hex 32
APP_KEY=

# 应用运行环境，生产固定为 production
APP_ENV=production

# MySQL 数据库连接（与 MYSQL_ROOT_PASSWORD 独立）
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# MySQL root 密码（独立随机值）
MYSQL_ROOT_PASSWORD=

# Redis 连接
REDIS_HOST=redis
REDIS_PORT=6379

# 首次启动创建的管理员（生产不提供默认值，必须显式填写；密码至少 12 位）
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=