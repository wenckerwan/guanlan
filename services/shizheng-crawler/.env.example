# ===== LLM 提炼后端（可选；不配置则自动降级为规则模式，质量下降）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 观澜网站对接（每日推送 N 条时政到 hotspots）=====
# 例：https://api.guanlan.example.com 或 http://127.0.0.1:9501（不要带尾部斜杠）
GUANLAN_API_BASE=
GUANLAN_ADMIN_EMAIL=
GUANLAN_ADMIN_PASSWORD=
# 时政所属学科 id（默认 6 = 当代世界经济与政治）
GUANLAN_SUBJECT_ID=6
# 每日推送条数
DAILY_TOP_N=10

# ===== 告警与监控（可选）=====
# 告警 webhook（钉钉/企业微信/飞书机器人）
ALERT_WEBHOOK=
# 心跳 URL（如 healthchecks.io，跑完 ping 一次）
HEARTBEAT_URL=

# ===== 路径覆盖（可选，默认自包含在本目录下）=====
# SHIZHENG_DATA_DIR=
# SHIZHENG_LOG_DIR=

# ===== 抓取调优（可选）=====
# robots.txt 未声明 Crawl-delay 的主机使用的保守间隔秒数（默认 12）；
# 声明了 Crawl-delay 的主机（如 www.people.cn = 120）一律按 robots 值，此项无效
# CRAWL_DEFAULT_DELAY=12
# 人民网每频道抓取上限（默认 60；pipeline 最终只选 top N，调小可显著提速）
# LIMIT_PER_CHANNEL=60
# 正文最少汉字数：低于此值判为「链接堆 / 图注 / 版权行」假稿，不入库（默认 30）
# MIN_BODY_CJK=30
