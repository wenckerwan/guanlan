# 观澜 API 本地开发环境变量示例（占位值，非真实密钥）。
# 复制为 apps/api/.env 用于脱离容器直接跑 Hyperf；
# 走 docker compose 时，这些变量由 docker-compose.yml 的 api.environment 注入，
# 因此 apps/api/.env 被根 .gitignore 忽略、不入库。
APP_NAME=guanlan-api
APP_ENV=production

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=guanlan
DB_USERNAME=guanlan
DB_PASSWORD=change-me

REDIS_HOST=redis
SEARCH_HOST=http://meilisearch:7700
